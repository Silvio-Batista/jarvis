# Azure Speech (gratis) — necessario para a voz do Julio
# Portal: https://portal.azure.com -> Create a resource -> Speech
AZURE_SPEECH_KEY=cole_sua_chave_aqui
AZURE_SPEECH_REGION=brazilsouth

# Spotify — para TOCAR de verdade (nao so abrir a busca)
# 1) https://developer.spotify.com/dashboard -> Create app
# 2) Redirect URI: http://127.0.0.1:8888/callback
# 3) Copie Client ID e Client Secret
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback
# Opcional (Premium): 1 para usar start_playback oficial
SPOTIFY_USER_AUTH=0
